#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir"

jar="$(ls -1t target/microcli-*.jar 2>/dev/null | head -n 1 || true)"
if [[ -z "$jar" ]]; then
  echo "easydemo: target/microcli-*.jar not found; run 'mvn clean package' first" >&2
  exit 1
fi

# Prefer the Homebrew JDK 27, then JAVA_HOME, then whatever java is on PATH.
if command -v brew >/dev/null 2>&1; then
  homebrew_jdk="$(brew --prefix openjdk 2>/dev/null || true)"
  if [[ -n "$homebrew_jdk" && -x "$homebrew_jdk/bin/java" ]]; then
    java="$homebrew_jdk/bin/java"
  fi
fi

if [[ -z "${java:-}" && -n "${JAVA_HOME:-}" && -x "${JAVA_HOME}/bin/java" ]]; then
  java="${JAVA_HOME}/bin/java"
fi

java="${java:-java}"

exec "$java" -cp "$jar" cz.utulnykoutek.microcli.easy.EasyDemo "$@"
